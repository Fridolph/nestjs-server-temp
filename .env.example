DB_TYPE = mysql
DB_HOST = localhost
DB_PORT = 3306
DB_USERNAME = admin
DB_PASSWORD = admin
DB_DATABASE = nestjs_demo

SECRET = 'fridolph-learn-nestjs'

PREFIX = /api
VERSION = v1
SERVER_PORT = 3000

# 默认打开日志开关
LOG_ON = true
LOG_LEVEL = info

# 允许任意来源；携带 Cookie 时服务端会回显请求 Origin
AUTH_ALLOWED_ORIGINS=*
# 如需限制来源，改为以下配置（多个用英文逗号分隔）；生产必须显式配置
# AUTH_ALLOWED_ORIGINS=https://admin.example.com
